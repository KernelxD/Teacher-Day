{
  "name": "vtec-teacher-day",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && node scripts/og-image.mjs render && firebase deploy --only hosting",
    "og:image": "node scripts/og-image.mjs render",
    "test:og": "node --test scripts/og-image.test.mjs",
